{
    "Logging": {
        "LogLevel": {
            "Default": "Warning",
            "Microsoft": "None"
        }
    },

    "DbType": "Sqlite", // SqlServer, MySql
    "ConnectionStrings": {
        "DefaultConnection": "Data Source=mydb.db"
    },
    "Serilog": {
        "Using": [ "Serilog.Sinks.File" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning"
            }
        },
        "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]

    }
}