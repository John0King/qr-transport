<Window x:Class="KN.SafeCommunicationPlatform.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KN.SafeCommunicationPlatform.Wpf"
        xmlns:cv="clr-namespace:OpenCvSharp;assembly=OpenCvSharp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44*"/>
            <RowDefinition Height="73*"/>
            <RowDefinition Height="74*"/>
            <RowDefinition Height="244*"/>
        </Grid.RowDefinitions>
        <Button Content="开始捕捉" HorizontalAlignment="Left" Margin="63,7,0,0" VerticalAlignment="Top" Height="56" Width="141" Click="Go" Grid.Row="1"/>
        <Button Content="停止捕捉" HorizontalAlignment="Left" Margin="209,7,0,0" VerticalAlignment="Top" Height="56" Width="141" Click="Stop" Grid.Row="1"/>
        <Border  Width="100" Height="100" Margin="672,12,28,5" Grid.RowSpan="2" BorderThickness="1" Background="Gray">
            <Image x:Name="Viewer" ></Image>
        </Border>
       
        <TextBox x:Name="result" Selector.IsSelected="True" Height="40" Margin="20,17,20,0" VerticalContentAlignment="Center" Grid.Row="2">none</TextBox>
        <ScrollViewer Grid.Row="3" >
            <TextBlock x:Name="log" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" TextWrapping="Wrap" Background="AliceBlue" FontFamily="Cascadia Code"  >

            </TextBlock>
        </ScrollViewer>
        
    </Grid>
</Window>
