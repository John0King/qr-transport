<Window x:Name="window" x:Class="KN.SafeCommunicationPlatform.Wpf.QRWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KN.SafeCommunicationPlatform.Wpf"
        xmlns:sk="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        mc:Ignorable="d"
        Title="QRWindow" Height="600" Width="800" WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <!--左侧面版-->
        <DockPanel Margin="0,0,5,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" VerticalAlignment="Top">
                <Button Height="40" HorizontalAlignment="Center" Padding="50,0" Click="ConnectButton_Click" IsEnabled="{Binding IsCanConnect}">连接</Button>
                <Button Height="40" HorizontalAlignment="Center" Padding="50,0" IsEnabled="{Binding IsCanDisConnect}">断开</Button>
                <Button Height="40" HorizontalAlignment="Center" Padding="50,0" Click="Button_Click" >生成二维码</Button>
                <Button Height="40" HorizontalAlignment="Center" Padding="50,0" Click="Button_Click_1" >读取</Button>
            </StackPanel>
            <StackPanel>
                <Label>原 （base64）</Label>
                <TextBox x:Name="obxt" TextWrapping="Wrap"  Height="90"></TextBox>
                <Label>文本</Label>
                <TextBox x:Name="txt" TextWrapping="Wrap" Height="90"></TextBox>
                <Label>二进制 （base64）</Label>
                <TextBox x:Name="bxt" TextWrapping="Wrap"  Height="90"></TextBox>
            </StackPanel>
        </DockPanel>
        <Border Grid.Column="1" BorderBrush="black" BorderThickness="1,0,0,0" ClipToBounds="True">
            <Canvas >
                <!--<Image x:Name="Qr" Width="300" Height="300" Canvas.Top="0" Canvas.Right="0" Source="{Binding QrBitmap, ElementName=window}" ></Image>-->
                <sk:SKElement x:Name="SkViewer" Canvas.Top="0" Canvas.Right="0" 
                              Width="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Canvas}}}" 
                              Height="{Binding ActualWidth, Mode=OneWay, RelativeSource={RelativeSource Self}}" PaintSurface="SKElement_PaintSurface" />


            </Canvas>
        </Border>
        
    </Grid>
</Window>
